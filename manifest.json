{
  "manifest_version": 3,
  "name": "Streamonio",
  "version": "0.6.2",
  "description": "A browser-extension to call HTTP endpoints with page's media URLs (podcasts, radios & live streams)",
  "author": "Kostis Anagnostopoulos",
  "homepage_url": "https://github.com/ankostis/streamonio",
  "developer": {
    "name": "Kostis Anagnostopoulos",
    "url": "https://github.com/ankostis"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["dist/broker.js"],
    "service_worker": "dist/broker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/page.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "dist/popup-pane.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Streamonio"
  },
  "options_ui": {
    "page": "dist/options-pane.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/page.js", "dist/hover-pane.html", "dist/hover-pane.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "streamonio@dev.ankostis.com",
      "strict_min_version": "115.0"
    }
  }
}
